diff --git a/im/pinyin/pinyin.cpp b/im/pinyin/pinyin.cpp
index 7047c16..fede46c 100644
--- a/im/pinyin/pinyin.cpp
+++ b/im/pinyin/pinyin.cpp
@@ -532,8 +532,10 @@ void PinyinEngine::updateUI(InputContext *inputContext) {
     const auto &context = state->context_;
     if (context.selected()) {
         auto sentence = context.sentence();
+        state->undoLearnOnBackspace_ = false;
         if (shouldLearn(inputContext)) {
             state->context_.learn();
+            state->undoLearnOnBackspace_ = state->context_.canUndoLearn();
         }
         inputContext->commitString(sentence);
         inputContext->updatePreedit();
@@ -2098,6 +2100,14 @@ void PinyinEngine::keyEvent(const InputMethodEntry &entry, KeyEvent &event) {
         return;
     }
 
+    if (state->undoLearnOnBackspace_) {
+        state->undoLearnOnBackspace_ = false;
+        if (event.key().check(FcitxKey_BackSpace) && state->context_.empty()) {
+            PINYIN_DEBUG() << "Undo learning of the last commit";
+            state->context_.undoLearn();
+        }
+    }
+
     // Small hack to debug tabbed candidate on desktop.
 #if 0
     KeyList list;
@@ -2429,6 +2439,7 @@ void PinyinEngine::doReset(InputContext *inputContext) const {
     state->context_.clear();
     state->context_.clearContextWords();
     state->predictWords_.reset();
+    state->undoLearnOnBackspace_ = false;
     inputContext->inputPanel().reset();
     inputContext->updatePreedit();
     inputContext->updateUserInterface(UserInterfaceComponent::InputPanel);
